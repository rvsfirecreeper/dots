{
    "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
    "author": "Jan Reinsch <jan@coded-aesthetics.com>",
    "name": "Catppuccin",
    "themes": [
        {
            "name": "Catppuccin",
            "appearance": "{{appearance}}",
            "style": {
                // Basic text and background colors
                "background": "{{background}}",
                "text": "{{foreground}}",
                "text.muted": "{{mix text base 20}}",
                "text.placeholder": "{{mix text base 30}}",
                "text.disabled": "{{mix text base 40}}",
                "text.accent": "{{color4}}",

                // Icon colors - match text hierarchy
                "icon": "{{foreground}}",
                "icon.muted": "{{mix text base 20}}",
                "icon.disabled": "{{mix text base 40}}",
                "icon.placeholder": "{{mix text base 30}}",
                "icon.accent": "{{color4}}",

                // Border colors - subtle but visible
                "border": "{{mix text base 60}}",
                "border.variant": "{{mix text base 70}}",
                "border.focused": "{{color4}}",
                "border.selected": "{{color4}}",
                "border.transparent": "#00000000",
                "border.disabled": "{{mix text base 80}}",

                // Surface backgrounds - slightly elevated from main background
                "surface.background": "{{background}}",
                "elevated_surface.background": "{{mix base text 10}}",

                // Interactive element states
                "element.background": "transparent",
                "element.hover": "{{mix base text 20}}",
                "element.active": "{{mix base blue 30}}",
                "element.selected": "{{mix base blue 25}}",
                "element.disabled": "{{mix base text 5}}",

                // Ghost elements - more subtle interactions
                "ghost_element.background": "transparent",
                "ghost_element.hover": "{{mix base text 10}}",
                "ghost_element.active": "{{mix base text 20}}",
                "ghost_element.selected": "{{mix base blue 15}}",
                "ghost_element.disabled": "transparent",

                // Drag and drop target
                "drop_target.background": "{{mix base blue 35}}",

                // Application frame elements
                "status_bar.background": "{{mix base text 5}}",
                "title_bar.background": "{{background}}",
                "title_bar.inactive_background": "{{mix base text 3}}",
                "toolbar.background": "{{background}}",

                // Side panels
                "panel.background": "{{background}}",
                "panel.focused_border": "{{color4}}",

                // Editor panes
                "pane.focused_border": "{{color4}}",
                "pane_group.border": "{{mix text base 60}}",

                // Tab bar and tabs
                "tab_bar.background": "{{mix base text 5}}",
                "tab.inactive_background": "transparent",
                "tab.active_background": "{{background}}",

                // Main editor area
                "editor.background": "{{background}}",
                "editor.foreground": "{{foreground}}",
                "editor.gutter.background": "{{background}}",
                "editor.subheader.background": "{{mix base text 5}}",
                "editor.active_line.background": "{{mix base text 10}}",
                "editor.highlighted_line.background": "{{mix base yellow 20}}",
                "editor.line_number": "{{mix text base 40}}",
                "editor.active_line_number": "{{foreground}}",
                "editor.invisible": "{{mix text base 50}}",
                "editor.wrap_guide": "{{mix text base 60}}",
                "editor.active_wrap_guide": "{{mix text base 40}}",
                "editor.indent_guide": "{{mix text base 60}}",
                "editor.indent_guide_active": "{{mix text base 40}}",
                "editor.document_highlight.read_background": "{{mix base yellow 25}}",
                "editor.document_highlight.write_background": "{{mix base red 25}}",
                "editor.document_highlight.bracket_background": "{{mix base blue 25}}",

                // Integrated terminal
                "terminal.background": "{{background}}",
                "terminal.foreground": "{{foreground}}",
                "terminal.bright_foreground": "{{text}}",
                "terminal.dim_foreground": "{{mix text base 20}}",
                "terminal.ansi.background": "{{background}}",
                "terminal.ansi.black": "{{color0}}",
                "terminal.ansi.red": "{{color1}}",
                "terminal.ansi.green": "{{color2}}",
                "terminal.ansi.yellow": "{{color3}}",
                "terminal.ansi.blue": "{{color4}}",
                "terminal.ansi.magenta": "{{color5}}",
                "terminal.ansi.cyan": "{{color6}}",
                "terminal.ansi.white": "{{color7}}",
                "terminal.ansi.bright_black": "{{color8}}",
                "terminal.ansi.bright_red": "{{color9}}",
                "terminal.ansi.bright_green": "{{color10}}",
                "terminal.ansi.bright_yellow": "{{color11}}",
                "terminal.ansi.bright_blue": "{{color12}}",
                "terminal.ansi.bright_magenta": "{{color13}}",
                "terminal.ansi.bright_cyan": "{{color14}}",
                "terminal.ansi.bright_white": "{{color15}}",

                // Search functionality
                "search.match_background": "{{mix base yellow 40}}",

                // Scrollbar elements
                "scrollbar.track.background": "transparent",
                "scrollbar.track.border": "transparent",
                "scrollbar.thumb.background": "{{mix text base 50}}",
                "scrollbar.thumb.border": "transparent",
                "scrollbar.thumb.hover_background": "{{mix text base 30}}",

                // Status indicators - success, warning, error, info
                "success": "{{color2}}",
                "success.background": "{{mix base green 25}}",
                "success.border": "{{color2}}",

                "warning": "{{color3}}",
                "warning.background": "{{mix base yellow 25}}",
                "warning.border": "{{color3}}",

                "error": "{{color1}}",
                "error.background": "{{mix base red 25}}",
                "error.border": "{{color1}}",

                "info": "{{color4}}",
                "info.background": "{{mix base blue 25}}",
                "info.border": "{{color4}}",

                "hint": "{{mix text base 20}}",
                "hint.background": "{{mix base text 15}}",
                "hint.border": "{{mix text base 20}}",

                // Git status colors
                "created": "{{color2}}",
                "created.background": "{{mix base green 25}}",
                "created.border": "{{color2}}",

                "modified": "{{color3}}",
                "modified.background": "{{mix base yellow 25}}",
                "modified.border": "{{color3}}",

                "deleted": "{{color1}}",
                "deleted.background": "{{mix base red 25}}",
                "deleted.border": "{{color1}}",

                "renamed": "{{color4}}",
                "renamed.background": "{{mix base blue 25}}",
                "renamed.border": "{{color4}}",

                "conflict": "{{color5}}",
                "conflict.background": "{{mix base pink 25}}",
                "conflict.border": "{{color5}}",

                "ignored": "{{mix text base 30}}",
                "ignored.background": "{{mix base text 10}}",
                "ignored.border": "{{mix text base 30}}",

                "hidden": "{{mix text base 40}}",
                "hidden.background": "transparent",
                "hidden.border": "{{mix text base 40}}",

                "predictive": "{{mix text base 30}}",
                "predictive.background": "{{mix base text 10}}",
                "predictive.border": "{{mix text base 30}}",

                "unreachable": "{{mix text base 50}}",
                "unreachable.background": "{{mix base text 3}}",
                "unreachable.border": "{{mix text base 50}}",

                // Link styling
                "link_text.hover": "{{mix blue text 10}}",

                // Syntax highlighting - follows standard color assignments
                "syntax": {
                    // Comments - muted but readable
                    "comment": {
                        "color": "{{mix text base 20}}",
                        "font_style": "italic"
                    },
                    "comment.doc": {
                        "color": "{{mix text base 10}}",
                        "font_style": "italic"
                    },

                    // Keywords
                    "keyword": {
                        "color": "{{color1}}"
                    },

                    // Strings
                    "string": {
                        "color": "{{color2}}"
                    },
                    "string.escape": {
                        "color": "{{color6}}"
                    },
                    "string.regex": {
                        "color": "{{color6}}"
                    },

                    // Numbers and constants
                    "number": {
                        "color": "{{color3}}"
                    },
                    "constant": {
                        "color": "{{color3}}"
                    },
                    "boolean": {
                        "color": "{{color5}}"
                    },

                    // Functions
                    "function": {
                        "color": "{{color4}}"
                    },
                    "constructor": {
                        "color": "{{color4}}"
                    },

                    // Types
                    "type": {
                        "color": "{{color5}}"
                    },
                    "enum": {
                        "color": "{{color5}}"
                    },

                    // Variables
                    "variable": {
                        "color": "{{foreground}}"
                    },
                    "variable.special": {
                        "color": "{{color5}}"
                    },

                    // Properties and attributes
                    "property": {
                        "color": "{{color4}}"
                    },
                    "attribute": {
                        "color": "{{color3}}"
                    },

                    // Operators - typically cyan (color6)
                    "operator": {
                        "color": "{{color6}}"
                    },

                    // Punctuation - subtle but visible
                    "punctuation": {
                        "color": "{{mix text base 10}}"
                    },
                    "punctuation.bracket": {
                        "color": "{{foreground}}"
                    },
                    "punctuation.delimiter": {
                        "color": "{{mix text base 10}}"
                    },

                    // Tags (HTML/XML)
                    "tag": {
                        "color": "{{color1}}"
                    },

                    // Labels and identifiers
                    "label": {
                        "color": "{{color4}}"
                    },

                    // Text literals
                    "text.literal": {
                        "color": "{{color2}}"
                    },

                    // Titles and headings
                    "title": {
                        "color": "{{color4}}",
                        "font_weight": 700
                    },

                    // Links in markdown/docs
                    "link_text": {
                        "color": "{{color4}}",
                        "font_style": "italic"
                    },
                    "link_uri": {
                        "color": "{{color6}}"
                    },

                    // Text emphasis
                    "emphasis": {
                        "font_style": "italic"
                    },
                    "emphasis.strong": {
                        "font_weight": 700
                    },

                    // Special syntax elements
                    "embedded": {
                        "color": "{{foreground}}"
                    },
                    "preproc": {
                        "color": "{{color1}}"
                    },
                    "primary": {
                        "color": "{{foreground}}"
                    },
                    "variant": {
                        "color": "{{color5}}"
                    },

                    // Editor hints and diagnostics
                    "hint": {
                        "color": "{{mix text base 20}}",
                        "font_weight": 700
                    },
                    "predictive": {
                        "color": "{{mix text base 30}}",
                        "font_style": "italic"
                    }
                },

                // Collaborative editing - different users get different colors
                "players": [
                    {
                        "cursor": "{{color4}}",
                        "background": "{{color4}}",
                        "selection": "{{mix base blue 35}}"
                    },
                    {
                        "cursor": "{{color2}}",
                        "background": "{{color2}}",
                        "selection": "{{mix base green 35}}"
                    },
                    {
                        "cursor": "{{color3}}",
                        "background": "{{color3}}",
                        "selection": "{{mix base yellow 35}}"
                    },
                    {
                        "cursor": "{{color5}}",
                        "background": "{{color5}}",
                        "selection": "{{mix base pink 35}}"
                    }
                ]
            }
        }
    ]
}

